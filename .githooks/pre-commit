#!/bin/sh
# Static analysis gate: block the commit when detekt (incl. ktlint formatting rules) fails.
echo "pre-commit: running detekt..."
./gradlew detekt --quiet
status=$?
if [ $status -ne 0 ]; then
  echo "pre-commit: detekt failed. Fix the findings (reports under */build/reports/detekt/)."
  exit $status
fi
